{
  "name": "Global Audio Mode: MANUAL - Explicit Opt-in Required",
  "description": "Test case where only components with explicit audioSync props sync with audio",
  "testCase": "global_audio_mode_manual",
  "expectedBehavior": "Only CountdownTimer syncs (has audioSync prop). TitleCard and ImageWithZoom stay static despite global sync being enabled.",
  "request": {
    "width": 1920,
    "height": 1080,
    "fps": 30,
    "timeline": [
      {
        "component": "TitleCard",
        "props": {
          "text": "NO AUDIOSYNC PROP = STATIC",
          "color": "#CCCCCC",
          "fontSize": 52,
          "animationType": "fadeIn"
        },
        "startFrame": 0,
        "durationInFrames": 300
      },
      {
        "component": "CountdownTimer",
        "props": {
          "startNumber": 7,
          "endNumber": 0,
          "color": "#FF4500",
          "fontSize": 140,
          "suffix": "!!!",
          "audioSync": {
            "override": true,
            "enabled": true,
            "type": "beat",
            "reactivity": 2.0
          }
        },
        "startFrame": 60,
        "durationInFrames": 240
      },
      {
        "component": "ImageWithZoom",
        "props": {
          "fallbackText": "ALSO STATIC (NO PROP)",
          "fallbackColor": "#696969",
          "direction": "out",
          "zoomIntensity": 0.15
        },
        "startFrame": 30,
        "durationInFrames": 270
      }
    ],
    "audioConfig": {
      "audioUrl": "start-again.mp3",
      "volume": 0.8,
      "fadeIn": 1,
      "loop": true,
      "globalSync": {
        "enabled": true,
        "mode": "manual",
        "defaultReactivity": 1.0,
        "masterIntensity": 0.7
      }
    }
  }
}